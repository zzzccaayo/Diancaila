.page { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.photo { width: 100%; height: 400rpx; border-radius: 16rpx; overflow: hidden; background: #fff4ee; }
.photo-img { width: 100%; height: 100%; }
.photo-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ff7a45; }
.photo-icon { font-size: 120rpx; }
.photo-tip { font-size: 26rpx; margin-top: 12rpx; }
.photo-actions { display: flex; justify-content: space-around; margin-top: 20rpx; color: #ff7a45; }
.danger { color: #ff4d4f; }
.row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.row:last-child { border-bottom: none; }
.label { width: 110rpx; font-weight: bold; }
.input { flex: 1; }
.save { margin-top: 40rpx; }
.delete { margin-top: 24rpx; background: #fff; color: #ff4d4f; border-radius: 40rpx; }
