<view class="page">
  <view class="card">
    <view class="row">
      <text class="label">桌号</text>
      <input class="input" type="number" placeholder="请输入桌号，如 8" value="{{tableNo}}" bindinput="onTableInput" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">已选菜品</view>
    <view wx:for="{{items}}" wx:key="id" class="item">
      <text class="item-icon">{{item.icon}}</text>
      <text class="item-name">{{item.name}}</text>
      <view class="stepper">
        <view class="step-btn minus" data-id="{{item.id}}" bindtap="onMinus">-</view>
        <text class="step-num">{{item.count}}</text>
        <view class="step-btn plus" data-id="{{item.id}}" bindtap="onAdd">+</view>
      </view>
      <text class="price item-price">¥{{item.price * item.count}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">备注</view>
    <textarea class="remark" placeholder="口味、忌口等（选填）" value="{{remark}}" bindinput="onRemarkInput" maxlength="100" />
  </view>

  <view style="height: 140rpx;"></view>

  <view class="footer">
    <text>共 {{totalCount}} 份，合计 <text class="price">¥{{totalPrice}}</text></text>
    <button class="btn-primary submit" disabled="{{submitting}}" bindtap="submit">提交订单</button>
  </view>
</view>
