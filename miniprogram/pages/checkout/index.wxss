.page { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.card-title { font-weight: bold; margin-bottom: 16rpx; }
.row { display: flex; align-items: center; }
.label { width: 100rpx; font-weight: bold; }
.input { flex: 1; }
.item { display: flex; align-items: center; padding: 16rpx 0; }
.item-icon { font-size: 44rpx; margin-right: 16rpx; }
.item-name { flex: 1; }
.item-price { width: 120rpx; text-align: right; }
.stepper { display: flex; align-items: center; }
.step-btn { width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center; border-radius: 50%; font-size: 32rpx; }
.minus { border: 2rpx solid #ff7a45; color: #ff7a45; }
.plus { background: #ff7a45; color: #fff; }
.step-num { width: 56rpx; text-align: center; }
.remark { width: 100%; height: 150rpx; font-size: 26rpx; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05); }
.submit { margin: 0; width: 240rpx; font-size: 30rpx; }
