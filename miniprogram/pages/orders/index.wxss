.page { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.head { display: flex; justify-content: space-between; padding-bottom: 16rpx; border-bottom: 1rpx solid #f2f2f2; margin-bottom: 12rpx; }
.table { font-weight: bold; font-size: 30rpx; }
.status { color: #ff7a45; }
.line { display: flex; justify-content: space-between; padding: 8rpx 0; color: #555; }
.remark { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.foot { display: flex; justify-content: space-between; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f2f2f2; }
.time { color: #999; font-size: 24rpx; }
.empty { text-align: center; padding-top: 200rpx; color: #999; }
.empty-icon { font-size: 120rpx; margin-bottom: 20rpx; }
.go { width: 300rpx; margin-top: 40rpx; }
.master-bar { display: flex; justify-content: space-between; align-items: center;  background: #fff4ee; color: #ff7a45; padding: 20rpx 24rpx; border-radius: 16rpx; margin-bottom: 20rpx; font-weight: bold; }
.master-count { font-size: 36rpx; margin: 0 6rpx; }
.card-done { opacity: 0.6; }
.status-done { color: #52c41a; }
.actions { margin-top: 20rpx; display: flex; justify-content: flex-end; align-items: center; }
.actions:empty { display: none; }
.done-btn { display: inline-block; width: 240rpx; font-size: 28rpx; margin: 0; }
.undo { color: #999; font-size: 24rpx; text-decoration: underline; }
.claim { text-align: center; color: #bbb; font-size: 24rpx; padding: 40rpx 0; }
.kiss { color: #ff4d8d; font-weight: bold; }
.cancel { color: #ff4d4f; font-size: 26rpx; padding: 10rpx 24rpx; border: 2rpx solid #ff4d4f; border-radius: 32rpx; margin-right: 20rpx; }
.card-cancelled { opacity: 0.45; }
.status-cancelled { color: #999; }
.bell { font-size: 24rpx; font-weight: normal; padding: 6rpx 16rpx; border: 2rpx solid #ff7a45; border-radius: 28rpx; }
