.page { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.head { display: flex; justify-content: space-between; padding-bottom: 16rpx; border-bottom: 1rpx solid #f2f2f2; margin-bottom: 12rpx; }
.table { font-weight: bold; font-size: 30rpx; }
.status { color: #ff7a45; }
.line { display: flex; justify-content: space-between; padding: 8rpx 0; color: #555; }
.remark { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.foot { display: flex; justify-content: space-between; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f2f2f2; }
.time { color: #999; font-size: 24rpx; }
.empty { text-align: center; padding-top: 200rpx; color: #999; }
.empty-icon { font-size: 120rpx; margin-bottom: 20rpx; }
.go { width: 300rpx; margin-top: 40rpx; }
