<view class="page">
  <view wx:if="{{isMaster}}" class="master-bar">
    👑 主人模式 · 待制作 <text class="master-count">{{pendingCount}}</text> 单
  </view>

  <view wx:if="{{!loading && orders.length === 0}}" class="empty">
    <view class="empty-icon">🍽️</view>
    <view>还没有订单</view>
    <button wx:if="{{!isMaster}}" class="btn-primary go" bindtap="goMenu">去点菜</button>
  </view>

  <view wx:for="{{orders}}" wx:key="_id" class="card {{item.status === '已完成' ? 'card-done' : ''}} {{item.status === '已撤回' ? 'card-cancelled' : ''}}">
    <view class="head">
      <text class="table">🕒 {{item.timeText}}</text>
      <text class="status {{item.status === '已完成' ? 'status-done' : ''}} {{item.status === '已撤回' ? 'status-cancelled' : ''}}">{{item.status}}</text>
    </view>
    <view wx:for="{{item.items}}" wx:for-item="dish" wx:key="id" class="line">
      <text>{{dish.name}}</text>
      <text>× {{dish.count}}</text>
    </view>
    <view wx:if="{{item.remark}}" class="remark">备注：{{item.remark}}</view>
    <view class="foot">
      <text></text>
      <text>共 <text class="kiss">{{item.totalCount}} 个亲亲 😘</text></text>
    </view>
    <view class="actions">
      <text wx:if="{{item.status === '待制作' && openid && item._openid === openid}}"
        class="cancel" data-id="{{item._id}}" bindtap="cancelOrder">撤回订单</text>
      <block wx:if="{{isMaster}}">
        <button wx:if="{{item.status === '待制作'}}" class="btn-primary done-btn"
          data-id="{{item._id}}" data-status="已完成" bindtap="setStatus">✅ 做好了</button>
        <text wx:elif="{{item.status === '已完成'}}" class="undo" data-id="{{item._id}}" data-status="待制作" bindtap="setStatus">撤销完成</text>
      </block>
    </view>
  </view>

  <view wx:if="{{canClaim}}" class="claim" bindtap="claimMaster">我是主人，绑定主人身份 →</view>
</view>
